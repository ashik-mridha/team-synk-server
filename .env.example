NODE_ENV=development
PORT=5000

# Put the database name in the URI too. Without it the driver silently uses "test".
MONGODB_URI=mongodb://127.0.0.1:27017/team-sync
# The one database used by Mongoose AND Better Auth (defaults to team-sync)
DB_NAME=team-sync
# true on Atlas / a replica set (Better Auth then uses transactions)
MONGODB_USE_TRANSACTIONS=false

# Allowed browser origin(s), comma separated, no trailing slash. The first is used for invite links.
# Production example: https://team-synk-omega.vercel.app,https://team-synk-git-main-you.vercel.app
CLIENT_URL=http://localhost:3000

# Better Auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-min
# Public URL of this API. REQUIRED in production, e.g. https://teamsync-server.onrender.com
BETTER_AUTH_URL=http://localhost:5000

# This account becomes a global admin on sign-up or at server start (leave empty to disable)
SUPER_ADMIN_EMAIL=

# Reverse proxies in front of the API. Render alone = 1. Render behind the Vercel rewrite = 2.
TRUST_PROXY=0

# Session cookie SameSite. lax = same-site or proxied through the web app (recommended).
# none = browser talks to the API directly from a different site (needs HTTPS; may be blocked by
# third-party cookie settings).
COOKIE_SAME_SITE=lax
# Optional: parent domain when app and API are sibling subdomains (app.example.com + api.example.com),
# e.g. example.com. Use together with COOKIE_SAME_SITE=lax.
COOKIE_DOMAIN=

# Max API requests per 15 minutes per IP (general API)
API_RATE_LIMIT_MAX=600
# Max sign-in / sign-up attempts per 15 minutes per IP
AUTH_RATE_LIMIT_MAX=10
