NODE_ENV=development
PORT=5000

# Put the database name in the URI too. Without it the driver silently uses "test".
MONGODB_URI=mongodb://127.0.0.1:27017/team-sync
# The one database used by Mongoose AND Better Auth (defaults to team-sync)
DB_NAME=team-sync
# Set to true on a replica set / Atlas so Better Auth uses transactions
MONGODB_USE_TRANSACTIONS=false

CLIENT_URL=http://localhost:3000

# Better Auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-min
# Public URL of this API (defaults to http://localhost:PORT)
BETTER_AUTH_URL=http://localhost:5000

# This account becomes a global admin on sign-up or at server start (leave empty to disable)
SUPER_ADMIN_EMAIL=

# Reverse proxies in front of the API (0 = none)
TRUST_PROXY=0

# Session cookie SameSite: lax (same-site / local dev) or none (client and API on different sites, requires HTTPS)
COOKIE_SAME_SITE=lax

# Max API requests per 15 minutes per IP (general API)
API_RATE_LIMIT_MAX=600

# Max sign-in / sign-up attempts per 15 minutes per IP
AUTH_RATE_LIMIT_MAX=10
